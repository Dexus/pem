{
    "tags": {
        "allowUnknownTags": false
    },
    "source": {
      "include": "./lib",
       "includePattern": ".js$",
       "excludePattern": "(node_modules/|test/|docs)"
    },
    "plugins": ["plugins/markdown"],
    "templates": {
      "cleverLinks": true,
      "monospaceLinks": true
    },
    "markdown": {
      "parser": "markdownit",
      "hardwrap": true
    },
    "opts": {
      "verbose": true,
      "encoding": "utf8",
      "destination": "docs/jsdoc/",
      "recurse": true,
      "readme": "./README.md",
      "template": "node_modules/docdash"
    },
    "docdash": {
        "static": true,
        "sort": true,
        "nameInOutputPath": false,
        "versionInOutputPath": false
    }
}
