{
  "author": "Andris Reinman <andris@kreata.ee>",
  "contributors": [
    {
      "name": "Josef Fröhle",
      "email": "github@josef-froehle.de",
      "url": "https://www.josef-froehle.de/"
    }
  ],
  "license": "MIT",
  "name": "pem",
  "description": "Create private keys and certificates with node.js and io.js",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dexus/pem.git"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./types/pem.d.ts",
      "import": "./index.mjs",
      "require": "./dist/index.js"
    },
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "types",
    "index.mjs"
  ],
  "type": "commonjs",
  "scripts": {
    "documentation": "yarn run build:lib && yarn run docco && yarn run jsdoc",
    "docco": "docco -l parallel -o docs/docco lib/helper.js lib/openssl.js lib/pem.js",
    "jsdoc": "jsdoc -c jsdoc.json",
    "build": "yarn run build:lib && ncc build -m -s --no-source-map-register lib/pem.js -o dist",
    "build:lib": "tsc -p .",
    "changelog": "auto-changelog -p --commit-limit false --output HISTORY.md",
    "coverage": "cross-env NODE_ENV=development nyc ./node_modules/.bin/mocha --recursive --bail --inline-diffs --reporter spec --check-leaks --use_strict $(find . -type f -name '*.spec.js'  ! -path './nyc_output/*' ! -path './coverage/*' ! -path './node_modules/*')",
    "lint": "eslint --fix lib/*.ts *.md *.json test/*.js test/*.spec.js index.mjs",
    "prepack": "yarn run build:lib",
    "test": "yarn run build:lib && yarn run lint && yarn run coverage",
    "test:opensslv3.0.1": "yarn run build > openssl_v3.0.1.log && yarn run test >> openssl_v3.0.1.log",
    "test:types": "tsd"
  },
  "nyc": {
    "reporter": [
      "html",
      "text"
    ],
    "exclude": [
      "**/*.spec.js",
      "test/pem.helper.js"
    ]
  },
  "dependencies": {
    "which": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chai": "5.2.3",
    "@types/dirty-chai": "2.0.5",
    "@types/node": "26.6.6",
    "@vercel/ncc": "0.45.0",
    "auto-changelog": "2.7.0",
    "chai": "4.5.0",
    "cross-env": "10.1.0",
    "dirty-chai": "2.0.1",
    "docco": "0.9.2",
    "docdash": "2.0.2",
    "eslint": "10.14.0",
    "eslint-plugin-chai-friendly": "1.2.1",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-json": "5.0.0",
    "eslint-plugin-markdown": "5.1.0",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.14.0",
    "jsdoc": "4.0.5",
    "marked": "18.1.3",
    "mocha": "^12.0.3",
    "nyc": "18.0.0",
    "tsd": "0.33.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "types": "types/pem.d.ts",
  "packageManager": "yarn@4.18.1"
}
